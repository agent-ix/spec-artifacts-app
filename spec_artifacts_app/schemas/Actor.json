{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/Actor.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/ActorId.json"
    },
    "name": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/NonEmptyText.json"
    },
    "kind": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/ActorKind.json"
    },
    "description": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/NonEmptyText.json",
      "description": "free text: authored prose describing the actor's role."
    },
    "line": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/LineNumber.json"
    }
  },
  "required": [
    "id",
    "name",
    "kind",
    "description",
    "line"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "One row of `## Actors`: who or what interacts with the application."
}
