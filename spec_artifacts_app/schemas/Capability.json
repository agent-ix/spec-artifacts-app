{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/Capability.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/CapabilityId.json"
    },
    "name": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/NonEmptyText.json"
    },
    "description": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/NonEmptyText.json",
      "description": "free text: authored prose stating the capability; the requirements beneath it carry the normative form."
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/ActorId.json"
      }
    },
    "line": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/LineNumber.json"
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "actors",
    "line"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "One row of `## Capabilities`: what the application does, and for whom."
}
