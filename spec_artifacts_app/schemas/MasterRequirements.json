{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/0.2.0/MasterRequirements.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/0.2.0/ArtifactId.json"
    },
    "title": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/0.2.0/NonEmptyText.json"
    },
    "type": {
      "type": "string",
      "const": "MasterRequirements"
    },
    "status": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/0.2.0/ArtifactStatus.json"
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/0.2.0/Relationship.json"
      }
    },
    "provenance": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/0.2.0/Provenance.json"
    },
    "purpose": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/0.2.0/Section.json"
    },
    "scope": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/0.2.0/Section.json"
    },
    "systemOverview": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/0.2.0/Section.json"
    },
    "structure": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/0.2.0/Section.json"
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/FieldDecl.json"
      },
      "minItems": 1,
      "description": "The specification's identity attributes, declared as one typed row per\nfield in `## Properties`, or as the alternate `sysml` fence form of the\nsame declarations (quoin FR-071)."
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-app/0.2.0/RequirementRef.json"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/ClauseRef.json"
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "title",
    "type",
    "relationships",
    "provenance",
    "purpose"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "The record of a `MasterRequirements` document: the front page of a\nspecification — its purpose, scope, and the set of requirements it rolls up.\n\nLike `ApplicationSpec`, it references the requirements it aggregates rather\nthan restating them, so the module that owns a requirement type stays the one\ndefinition of it."
}
